        {
          "id": "e2a5c12b-390a-4906-9807-fa017f7b7f5d",
          "name": "Let imageserver process multiple objects.",
          "request": {
            "name": "Let imageserver process multiple objects.",
            "description": {
              "content": "If an image server is configured, creates a job in the image server's database to process all the pids from the provided list. Needs admin credentials.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "imageserver",
                "process"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "skipexisting",
                  "value": "<number>",
                  "description": "Value 1 to skip creating a job for this pid if a job for a pid already exists."
                }
              ],
              "variable": []
            },
            "header": [
